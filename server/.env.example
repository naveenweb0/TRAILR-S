# Server Runtime Configuration
PORT=5001
NODE_ENV=development
CLIENT_ORIGIN="http://localhost:5173"
JWT_SECRET="schooldest_super_secure_jwt_secret_key_2026_enterprise_level"

# Neon PostgreSQL Database Configuration
# Pooled connection string (recommended for serverless & high concurrency):
DATABASE_URL="postgresql://[user]:[password]@[neon-hostname]-pooler.[region].neon.tech/schooldest_db?sslmode=require&pgbouncer=true"

# Direct connection string (recommended for Prisma migrations & push):
DIRECT_URL="postgresql://[user]:[password]@[neon-hostname].[region].neon.tech/schooldest_db?sslmode=require"

# Neon Auth Configuration (Managed Better Auth & Google OAuth)
NEON_AUTH_URL="https://[your-neon-auth-subdomain].neon.tech"
# Optional JWKS override (defaults to ${NEON_AUTH_URL}/.well-known/jwks.json):
# NEON_AUTH_JWKS_URL="https://[your-neon-auth-subdomain].neon.tech/.well-known/jwks.json"

# Cloudinary CDN & Asset Storage (Upload destination photos, school badges, cover images)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
CLOUDINARY_URL="cloudinary://[api_key]:[api_secret]@[cloud_name]"
